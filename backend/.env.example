# Copy to backend/.env and fill in. .env is gitignored; this file is not.

# Required - the extraction agent calls the Claude API with this key.
ANTHROPIC_API_KEY=sk-ant-...

# Shared password required to log in as editor/steward/admin - the roles that
# can upload and edit, and therefore trigger billed Claude API calls. Viewers
# never need it. If left unset the gate is OPEN (any password is accepted) and
# the app logs a warning at startup - set it before sharing a public link.
UPLOAD_ROLE_PASSWORD=

# Set to "true" when served over HTTPS so the session cookie gets the Secure
# flag. Must stay false for plain-http local development, or browsers will
# drop the cookie and login will appear to silently fail.
SESSION_COOKIE_SECURE=false

# Optional - point SQLite at a persistent disk (e.g. /var/data/data.db on a
# host with a mounted volume). Defaults to backend/data.db next to the code.
DATABASE_PATH=
